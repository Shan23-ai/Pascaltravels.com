{
  "name": "travel-tours-agency",
  "version": "1.0.0",
  "private": true,
  "description": "Global Horizon Travel & Tours Agency - Visas, Work, PR & East Africa Tours",
  "scripts": {
    "start": "npx http-server www -p 8080 -c-1",
    "build": "echo \"Static site - no build step required\"",
