{
  "version": 2,
  "functions": {
    "api/server.js": {
      "runtime": "@vercel/node@3.0.10"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/(?!api)(.+)",
      "dest": "/www/$1"
    },
    {
      "src": "/",
      "dest": "/www/index.html"
    }
  ],
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "env": {
    "NODE_ENV": "production",
    "PESALINK_PROVIDER": "none",
    "WU_MODE": "mock",
    "DB_ENABLED": "false"
  }
}
